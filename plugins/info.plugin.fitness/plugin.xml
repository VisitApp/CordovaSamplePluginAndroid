<?xml version='1.0' encoding='utf-8'?>
<plugin xmlns:android="http://schemas.android.com/apk/res/android"
    id="info.plugin.fitness"
    version="1.0.0"
    xmlns="http://apache.org/cordova/ns/plugins/1.0">

    <name>CordovaFitnessPlugin</name>

    <js-module
        name="CordovaFitnessPlugin"
        src="www/CordovaFitnessPlugin.js">

        <clobbers target="cordova.plugins.CordovaFitnessPlugin" />
    </js-module>

    <platform name="android">

        <config-file
            parent="/*"
            target="res/xml/config.xml">

            <feature name="CordovaFitnessPlugin">
                <param
                    name="android-package"
                    value="info.plugin.CordovaFitnessPlugin" />
            </feature>
        </config-file>


        <config-file
            parent="/*"
            target="AndroidManifest.xml">

            <!-- <uses-permission android:name="android.permission.INTERNET" />
            <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
            <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" /> -->


        </config-file>

        <source-file
            src="src/android/CordovaFitnessPlugin.java"
            target-dir="src/info/plugin" />

        <framework src="org.jetbrains.kotlinx:kotlinx-coroutines-core:1.4.2" />
        <framework src="org.jetbrains.kotlinx:kotlinx-coroutines-android:1.4.2" />
        <framework src="com.squareup.retrofit2:retrofit:2.9.0" />
        <framework src="com.squareup.retrofit2:converter-gson:2.9.0" />
        <framework src="com.squareup.okhttp3:okhttp:3.8.1" />
        <framework src="com.squareup.okhttp3:logging-interceptor:4.9.0" />
        <framework src="androidx.health.connect:connect-client:1.1.0-alpha07" />
        <framework src="com.jakewharton.timber:timber:5.0.1" />
        <framework src="androidx.constraintlayout:constraintlayout:2.1.1" />
        <framework src="androidx.core:core-ktx:1.13.1" />

        <resource-file src="deps/google_fit-debug.aar" target="libs/google_fit-debug.aar" />

        <framework src="plugin-settings.gradle" custom="true" type="gradleReference" />


    </platform>
</plugin>